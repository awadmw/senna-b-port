	hypervisor { // /hypervisor
			#address-cells = <0x00000002>;
			#size-cells = <0x00000000>;
			compatible = "qcom,gunyah-hypervisor-1.0", "qcom,gunyah-hypervisor", "simple-bus";
		qcom,gunyah-vm { // /hypervisor/qcom,gunyah-vm
				compatible = "qcom,gunyah-vm-id-1.0", "qcom,gunyah-vm-id";
				qcom,vmid = <0x00000003>;
				qcom,vendor = "Qualcomm";
		};
		qcom,gh-watchdog { // /hypervisor/qcom,gh-watchdog
				compatible = "qcom,gh-watchdog";
				interrupts = <0x00000000 0x00000000 0x00000001>;
		};
		qcom,resource-manager-rpc@90bf8a419a6a0539 { // /hypervisor/qcom,resource-manager-rpc@90bf8a419a6a0539
				compatible = "qcom,resource-manager-1-0", "qcom,resource-manager", "qcom,gunyah-message-queue", "qcom,gunyah-capability";
				reg = <0x90bf8a41 0x9a6a0539 0x90bf8a41 0x9a6a1379>;
				interrupts = <0x00000000 0x000003a0 0x00000001 0x00000000 0x000003a1 0x00000001>;
				qcom,free-irq-start = <0x000003c0>;
				qcom,is-full-duplex;
				qcom,tx-message-size = <0x000000f0>;
				qcom,rx-message-size = <0x000000f0>;
				qcom,tx-queue-depth = <0x00000008>;
				qcom,rx-queue-depth = <0x00000008>;
		};
	};
};
